rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSchoolAccount() {
      return isSignedIn()
        && (request.auth.token.email.endsWith('@fcps.org')
            || request.auth.token.email.endsWith('@my.fcps.org'));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSchoolAccount()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.type in ['photo', 'question'];

      // Owner may update only caption, message, and/or imageUrl
      allow update: if isOwner(resource.data.authorUid) && isSchoolAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'message', 'imageUrl']);

      // Any school-domain user may increment replyCount by exactly +1
      allow update: if isSchoolAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;

      // Replies are NOT cascade-deleted yet; this is a known, deferred gap.
      allow delete: if isOwner(resource.data.authorUid) && isSchoolAccount();
    }

    match /replies/{replyId} {
      allow read: if true;

      allow create: if isSchoolAccount()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.createdAt is string;

      // Owner may update only the message field
      allow update: if isOwner(resource.data.authorUid) && isSchoolAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message']);

      allow delete: if isOwner(resource.data.authorUid) && isSchoolAccount();
    }

    match /users/{uid} {
      // Users can only read/write their own profile doc — the doc ID is the uid.
      allow read: if request.auth.uid == uid;

      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'gradeLevel', 'createdAt']);

      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'gradeLevel', 'createdAt']);

      // delete is intentionally not allowed
    }

    match /contactMessages/{messageId} {
      // Public contact form: anyone, signed in or not, may send a message.
      // The field list must stay in sync with src/services/contactService.js.
      allow create: if request.resource.data.keys().hasOnly(
            ['firstName', 'lastName', 'email', 'subject', 'message', 'authorUid', 'createdAt', 'handled'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is string
        && request.resource.data.handled == false
        && request.resource.data.authorUid == (isSignedIn() ? request.auth.uid : null);

      // Messages are read and managed in the Firebase console, never by the
      // client — a public-writable inbox must not also be publicly readable.
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
