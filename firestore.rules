rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Moderator = signed-in user whose own users/{uid} profile doc has role
    // 'officer' or 'adviser'. Role is assigned ONLY by the site owner in the
    // Firebase Console (admin access bypasses rules) — it is never settable
    // through client code (see the users/{uid} hasOnly() lists below).
    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['officer', 'adviser'];
    }

    match /posts/{postId} {
      // Visible posts are publicly readable. Pending posts are readable only
      // by the post's own author or a moderator (officer/adviser).
      allow read: if resource.data.status == 'visible'
        || isOwner(resource.data.authorUid)
        || isModerator();

      // Only signed-in users may create posts; photo posts are rejected.
      // Status must match the author's role: moderators set 'visible',
      // everyone else must set 'pending'.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.type == 'question'
        && request.resource.data.status in ['pending', 'visible']
        && ((isModerator() && request.resource.data.status == 'visible')
            || (!isModerator() && request.resource.data.status == 'pending'));

      // Owner may update only caption, message, and/or imageUrl
      allow update: if isOwner(resource.data.authorUid) && isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'message', 'imageUrl']);

      // Any signed-in user may increment replyCount by exactly +1
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;

      // Soft-remove only: the post's own author, OR a moderator (officer/advisor
      // per their users/{uid} role), may set exactly the {removed, removedAt}
      // fields. This is a separate branch from the content-edit rule above —
      // the author can still edit their content AND remove their own post.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'removedAt'])
        && (isOwner(resource.data.authorUid) || isModerator());

      // Moderator may flip a pending post to visible
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'visible';

      // Hard delete is intentionally disabled — soft-remove via {removed,
      // removedAt} is the ONLY removal mechanism, for both authors and
      // officers/advisers, so removed content stays visible in the Archived
      // Posts view instead of being destroyed. (Falls through to the catch-all
      // deny below.)
    }

    match /replies/{replyId} {
      // Visible replies are publicly readable. Pending replies are readable
      // only by the reply's own author or a moderator.
      allow read: if resource.data.status == 'visible'
        || isOwner(resource.data.authorUid)
        || isModerator();

      // Signed-in users may create replies; status must match the author's role.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.status in ['pending', 'visible']
        && ((isModerator() && request.resource.data.status == 'visible')
            || (!isModerator() && request.resource.data.status == 'pending'));

      // Owner may update only the message field
      allow update: if isOwner(resource.data.authorUid) && isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message']);

      // Soft-remove only: the reply's own author, OR a moderator, may set
      // exactly the {removed, removedAt} fields.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'removedAt'])
        && (isOwner(resource.data.authorUid) || isModerator());

      // Moderator may flip a pending reply to visible
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'visible';

      // Hard delete is intentionally disabled — soft-remove via {removed,
      // removedAt} is the ONLY removal mechanism, for both authors and
      // officers/advisers, so removed content stays visible in the Archived
      // Posts view instead of being destroyed. (Falls through to the catch-all
      // deny below. A removed parent post does NOT cascade to replies; removed
      // replies are just hidden, which resolves the old cascade gap by making
      // it moot.)
    }

    match /users/{uid} {
      // Users can only read/write their own profile doc — the doc ID is the uid.
      allow read: if request.auth.uid == uid;

      // Account creation is Google-only in the app (see AuthProvider);
      // any signed-in user may mint a profile doc. `role` is intentionally
      // absent from BOTH hasOnly() lists below: it is admin-assigned only
      // (site owner in the Firebase Console) and must never be writable by
      // the user themselves through the app.
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt']);

      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'createdAt']);

      // delete is intentionally not allowed
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
