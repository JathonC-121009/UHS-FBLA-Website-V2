rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Moderator = signed-in user whose own users/{uid} profile doc has role
    // 'officer' or 'adviser'. Role is assigned ONLY by the site owner in the
    // Firebase Console (admin access bypasses rules) — it is never settable
    // through client code (see the users/{uid} hasOnly() lists below).
    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) in ['officer', 'adviser'];
    }

    match /posts/{postId} {
      // Visible posts are publicly readable. Pending posts are readable only
      // by the post's own author or a moderator (officer/adviser).
      allow read: if resource.data.status == 'visible'
        || isOwner(resource.data.authorUid)
        || isModerator();

      // Only signed-in users may create posts; photo posts are rejected.
      // Every post starts 'pending', officers' and advisers' included, and
      // goes public only when a moderator approves it in the review dashboard.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.type == 'question'
        && request.resource.data.status == 'pending';

      // Owner may update only caption, message, and/or imageUrl
      allow update: if isOwner(resource.data.authorUid) && isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'message', 'imageUrl']);

      // Any signed-in user may increment replyCount by exactly +1
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;

      // Soft-remove only: the post's own author, OR a moderator (officer/advisor
      // per their users/{uid} role), may set exactly the {removed, removedAt}
      // fields. This is a separate branch from the content-edit rule above —
      // the author can still edit their content AND remove their own post.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'removedAt'])
        && (isOwner(resource.data.authorUid) || isModerator());

      // Moderator may approve a pending post (flip it to visible)
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'visible';

      // Normal removal is a soft-remove via {removed, removedAt}, which moves
      // the post to the Archive. Only a moderator may permanently delete a
      // post: one already archived, or one discarded from the review queue
      // (still pending, or 'rejected' from the earlier discard flow).
      allow delete: if isModerator()
        && (resource.data.get('removed', false) == true
            || resource.data.get('status', null) in ['pending', 'rejected']);
    }

    match /replies/{replyId} {
      // Visible replies are publicly readable. Pending replies are readable
      // only by the reply's own author or a moderator.
      allow read: if resource.data.status == 'visible'
        || isOwner(resource.data.authorUid)
        || isModerator();

      // Signed-in users may create replies; every reply starts 'pending'.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.status == 'pending';

      // Owner may update only the message field
      allow update: if isOwner(resource.data.authorUid) && isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message']);

      // Soft-remove only: the reply's own author, OR a moderator, may set
      // exactly the {removed, removedAt} fields.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'removedAt'])
        && (isOwner(resource.data.authorUid) || isModerator());

      // Moderator may approve a pending reply (flip it to visible)
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'visible';

      // A moderator may permanently delete a reply being discarded (pending,
      // or 'rejected' from the earlier discard flow), or any reply whose parent
      // post is archived, pending, or already gone, which is how deleting a
      // post clears out its replies. Otherwise replies are soft-removed.
      allow delete: if isModerator()
        && (resource.data.get('status', null) in ['pending', 'rejected']
            || !exists(/databases/$(database)/documents/posts/$(resource.data.postId))
            || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.get('removed', false) == true
            || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.get('status', null) in ['pending', 'rejected']);
    }

    match /contactMessages/{messageId} {
      // Public contact form: anyone, signed in or not, may send a message.
      // The field list must stay in sync with src/services/contactService.js.
      allow create: if request.resource.data.keys().hasOnly(
          ['firstName', 'lastName', 'email', 'subject', 'message', 'authorUid', 'createdAt', 'handled'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is string
        && request.resource.data.handled == false
        && request.resource.data.authorUid == (isSignedIn() ? request.auth.uid : null);

      // Messages are read and managed in the Firebase console, never by the
      // client — a public-writable inbox must not also be publicly readable.
      allow read, update, delete: if false;
    }

    match /users/{uid} {
      // Users can only read/write their own profile doc — the doc ID is the uid.
      allow read: if request.auth.uid == uid;

      // Account creation is Google-only in the app (see AuthProvider);
      // any signed-in user may mint a profile doc. `role` is intentionally
      // absent from BOTH hasOnly() lists below: it is admin-assigned only
      // (site owner in the Firebase Console) and must never be writable by
      // the user themselves through the app.
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt']);

      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'createdAt']);

      // delete is intentionally not allowed
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
