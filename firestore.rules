rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.type in ['photo', 'question'];

      // Owner editing their own post — ownership/identity fields are locked
      allow update: if isOwner(resource.data.authorUid)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt;

      // Any signed-in user may increment replyCount by exactly 1 when adding a reply —
      // this is the one exception to owner-only updates, needed because addReply()
      // increments the parent post's replyCount as a side effect.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;

      allow delete: if isOwner(resource.data.authorUid);
    }

    match /replies/{replyId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.createdAt is string;

      allow update: if isOwner(resource.data.authorUid)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(resource.data.authorUid);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
